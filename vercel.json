{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build && node scripts/vercel-assets.mjs",
    "outputDirectory": "dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30,
            "excludeFiles": "{node_modules/**,tests/**,docker/**,storage/**,bootstrap/cache/*.php,.env,.env.*,public/hot}"
        }
    },
    "rewrites": [{ "source": "/(.*)", "destination": "/api/index.php" }],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "pgsql",
        "DB_SCHEMA": "esdras",
        "DB_SSLMODE": "require",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync"
    }
}
